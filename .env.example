# Copy to .env (git-ignored) and fill in. Only the deploy/store scripts read this file; the mod itself never does.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
STRIPE_API_KEY=
LEMON_API_KEY=
OPENROUTER_API_KEY=

# mod.io publishing (tools/modio-publish.py)
MOD_IO_API_PATH=https://u-XXXXXXXX.modapi.io/v1
# OAuth 2 access token with write scope (mod.io > My account > Access); the plain API key is read-only
MOD_IO_ACCESS_TOKEN=
