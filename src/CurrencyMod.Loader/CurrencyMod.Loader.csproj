<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CurrencyMod.Loader</AssemblyName>
    <RootNamespace>CurrencyMod.Loader</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GameDir>$(MSBuildThisFileDirectory)..\..\..\</GameDir>
    <ManagedDir>$(GameDir)Humankind_Data\Managed\</ManagedDir>
    <BepInExDir>$(GameDir)BepInEx\</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExDir)core\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- dotnet build -p:SkipDeploy=true só compila (usado pelo script de empacotamento). -->
  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)plugins\CurrencyMod\" />
  </Target>

</Project>
