<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ensaio dos patches FORA do jogo: carrega os assemblies reais do jogo num processo .NET Framework e aplica todos os
    patches do MoreEmpires com o Harmony do BepInEx (resolve alvos, confere parâmetros, roda transpilers, compila o IL).
    Não executa nenhum método do jogo e não mexe no jogo em execução.

    Uso (depois de compilar o plugin em Release):
      "C:\Program Files\dotnet\dotnet.exe" build _Modding\src\MoreEmpires\Tests\PatchCheck -c Release
      _Modding\src\MoreEmpires\Tests\PatchCheck\bin\Release\net472\PatchCheck.exe

    Esperado: 27 ok + 2 falhas que só existem no .NET Framework (LoadPalette usa String.Split(char, StringSplitOptions)
    da BCL da Unity; LobbyScreen_LobbySlotsPanel.PostLoad chama um InternalCall da Unity). Para esses dois, o programa
    roda o transpiler direto sobre o IL e mostra a troca feita.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameDir>$(MSBuildThisFileDirectory)..\..\..\..\..\</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(GameDir)BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(GameDir)BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MoreEmpires"><HintPath>$(GameDir)_Modding\src\MoreEmpires\bin\Release\net472\MoreEmpires.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
