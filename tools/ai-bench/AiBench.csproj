<Project Sdk="Microsoft.NET.Sdk">

  <!-- AI cost x quality bench (outside the game). Not shipped in the release package. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AiBench</AssemblyName>
    <RootNamespace>AiBench</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameDir>$(MSBuildThisFileDirectory)..\..\..\</GameDir>
    <ModSrc>$(MSBuildThisFileDirectory)..\..\src\CurrencyMod\</ModSrc>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameDir)Humankind_Data\Managed\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <!-- The credential is read by the same code as the mod (DPAPI): the bench never sees the file or shows the key. -->
    <Compile Include="$(ModSrc)Diplomacy\Llm\Providers\Credentials.cs" Link="mod\Credentials.cs" />
    <Compile Include="$(ModSrc)Diplomacy\Llm\ApiKey.cs" Link="mod\ApiKey.cs" />
  </ItemGroup>

</Project>
