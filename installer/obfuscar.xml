<?xml version="1.0"?>
<!--
  Ofuscação do CurrencyMod.dll (Obfuscar 2.2.50), aplicada pelo tools\gerar-release.ps1. O script troca os marcadores (entre
  chaves) de entrada, saída, Managed do jogo e core do BepInEx pelos caminhos reais. Renomeia o que é interno e criptografa os textos (prompts inclusive).
  O que NÃO pode mudar de nome (inventário de 2026-10-06; ver docs\relatorios\instalador-1.0.0.md):
    - ModEntry.Start/Stop/Command: o carregador chama por reflexão;
    - métodos de patch do Harmony (Prefix/Postfix/...): o Harmony acha pelo nome, e os parâmetros pelo nome também;
    - mensagens da Unity (Awake/Update/...);
    - tipos salvos em JSON (CurrencyMod.json e DiplomaciaIA.json dentro do save, ministros.json, carga da recarga):
      renomear os campos quebraria saves antigos sem erro nenhum;
    - NativeEffects.DisplayedMoneyNet: o transpiler procura pelo nome;
    - P/Invoke da DPAPI (o nome é o ponto de entrada da DLL do Windows).
  Tipo novo salvo em JSON? Acrescente aqui (ou o save perde os dados dele).
-->
<Obfuscator>
  <Var name="InPath" value="{IN}" />
  <Var name="OutPath" value="{OUT}" />
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="HideStrings" value="true" />
  <Var name="RenameProperties" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="UseUnicodeNames" value="false" />
  <Var name="ReuseNames" value="true" />
  <Var name="XmlMapping" value="true" />
  <AssemblySearchPath path="{MANAGED}" />
  <AssemblySearchPath path="{BEPINEX}" />

  <Module file="$(InPath)\CurrencyMod.dll">
    <!-- Carregador -->
    <SkipType name="CurrencyMod.ModEntry" skipMethods="true" />

    <!-- Transpiler procura pelo nome -->
    <SkipMethod type="CurrencyMod.NativeEffects" name="DisplayedMoneyNet" />

    <!-- Harmony: métodos por convenção de nome -->
    <SkipMethod type="*" rx="^(Prefix|Postfix|Finalizer|Transpiler|TargetMethod|TargetMethods|Prepare|Cleanup)$" />

    <!-- Unity: mensagens chamadas pelo nome -->
    <SkipMethod type="*" rx="^(Awake|Start|Update|LateUpdate|FixedUpdate|OnGUI|OnEnable|OnDisable|OnDestroy|OnApplicationQuit)$" />

    <!-- Componentes da Unity: nomes de classe mantidos (logs legíveis e busca de scripts da Unity) -->
    <SkipType name="CurrencyMod.CentralBankWindow" />
    <SkipType name="CurrencyMod.DevTools" />
    <SkipType name="CurrencyMod.Diplomacia.IaModule" />
    <SkipType name="CurrencyMod.Diplomacia.UI.CorrespondenceTab" />
    <SkipType name="CurrencyMod.Diplomacia.UI.CouncilButton" />
    <SkipType name="CurrencyMod.Diplomacia.UI.CouncilScreen" />
    <SkipType name="CurrencyMod.Diplomacia.UI.InterceptedLettersTab" />
    <SkipType name="CurrencyMod.Diplomacia.UI.MailButton" />
    <SkipType name="CurrencyMod.Diplomacia.UI.MailScreen" />
    <SkipType name="CurrencyMod.Diplomacia.UI.ProvidersButtons" />
    <SkipType name="CurrencyMod.Diplomacia.UI.ProvidersScreen" />
    <SkipType name="CurrencyMod.NativeUI.DiplomacyEconomyPanel" />
    <SkipType name="CurrencyMod.NativeUI.DiplomacyTradePolicyPanel" />
    <SkipType name="CurrencyMod.NativeUI.NativeBankButton" />
    <SkipType name="CurrencyMod.NativeUI.NativeBankWindow" />
    <SkipType name="CurrencyMod.NativeUI.TradePostWindow" />

    <!-- Salvos em JSON: tipo, campos e propriedades com o nome de sempre -->
    <SkipType name="CurrencyMod.CurrencyWorld" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.EmpireCurrency" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.HistoryPoint" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.TradeRule" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.TollPrice" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.TradeIncident" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.TollRecord" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.TradeMode" skipFields="true" />
    <SkipType name="CurrencyMod.Diplomacia.IaWorld" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.IaNation" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.Persona" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.Feelings" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.Stance" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.DiaryEntry" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.MemoryNote" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.ActionRecord" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.Letter" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.CongressNews" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.InterceptRisk" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.ArmyMission" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.SpyTrack" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.IaRuntime" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.NationDetail" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.CallRecord" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.Council.CouncilMeeting" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.Council.CouncilSpeech" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.Council.CouncilExchange" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.Council.Minister" skipFields="true" skipProperties="true" />
    <SkipType name="CurrencyMod.Diplomacia.Council.Personality" skipFields="true" skipProperties="true" />
    <!-- Tipo anônimo enviado ao visualizador F10 (viewer.html lê os nomes) -->
    <SkipType name="&lt;&gt;f__AnonymousType*" skipMethods="true" skipFields="true" skipProperties="true" />

    <!-- P/Invoke (DPAPI) -->
    <SkipMethod type="CurrencyMod.Diplomacia.Llm.Providers.Dpapi" rx="^(CryptProtectData|CryptUnprotectData|LocalFree)$" />
  </Module>
</Obfuscator>
